    "When time runs out, the eyes turn red and growl. Change the time whenever you like." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند انتهاء الوقت تحمرّ العينان وتزمجران. يمكنك تغيير الوقت متى شئت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft die Zeit ab, werden die Augen rot und knurren. Die Zeit kannst du jederzeit ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When time runs out, the eyes turn red and growl. Change the time whenever you like."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando se acabe el tiempo, los ojos se pondrán rojos y gruñirán. Puedes cambiarlo cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand le temps est écoulé, les yeux deviennent rouges et grognent. Vous pouvez changer la durée à tout moment."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समय खत्म होने पर आँखें लाल हो जाएँगी और गुर्राएँगी। समय कभी भी बदल सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間切れになると、目が赤くなってうなります。時間はいつでも変えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시간이 다 되면 눈이 빨개지며 으르렁거려요. 시간은 언제든 바꿀 수 있어요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда время выйдет, глаза покраснеют и зарычат. Время можно менять в любой момент."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时间一到，眼睛会变红并发出咆哮。时间随时可以更改。"
          }
        }
      }
    },
    "Your eyes are red. 👀" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
