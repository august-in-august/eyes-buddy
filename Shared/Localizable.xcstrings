    "A huffy grunt, like someone got annoyed" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تذمّر ساخط كأن أحدهم انزعج"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein genervtes Grunzen, als wäre jemand sauer"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A huffy grunt, like someone got annoyed"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bufido molesto, como alguien enfadado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un grognement agacé, comme si quelqu'un se vexait"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नाराज़ होने पर निकली हुँकार जैसी"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ムッとした人のような不満げなうなり"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "짜증 난 사람의 툴툴거림"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недовольное фырканье, будто кто-то разозлился"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像有人不高兴时的一声哼"
          }
        }
      }
    },
    "A tiny creature lives in your camera cutout. Start a timer and it keeps watch, blinks when you poke it, and turns red when time runs out." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيش مخلوق صغير في فتحة الكاميرا. ابدأ المؤقت فيراقب، ويرمش عند لمسه، ويحمرّ عند انتهاء الوقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In deinem Kameraausschnitt lebt ein winziges Wesen. Starte einen Timer: Es hält Wache, blinzelt, wenn du es anstupst, und wird rot, wenn die Zeit abläuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tiny creature lives in your camera cutout. Start a timer and it keeps watch, blinks when you poke it, and turns red when time runs out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una criatura diminuta vive en el recorte de tu cámara. Inicia un temporizador y vigilará, parpadeará si la tocas y se pondrá roja cuando se acabe el tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une petite créature vit dans l'encoche de votre caméra. Lancez un minuteur : elle veille, cligne des yeux quand on la touche et devient rouge quand le temps est écoulé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके कैमरा कटआउट में एक नन्हा जीव रहता है। टाइमर शुरू करें तो वह नज़र रखता है, छूने पर पलकें झपकाता है और समय खत्म होने पर लाल हो जाता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラの切り欠きに小さな生き物が住んでいます。タイマーを始めると見守ってくれて、つつくとまばたきし、時間切れになると赤くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라 구멍에 작은 생명체가 살아요. 타이머를 시작하면 지켜보고, 콕 찌르면 깜빡이고, 시간이 다 되면 빨개져요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В вырезе вашей камеры живёт крошечное существо. Запустите таймер — оно будет следить, моргнёт, если его ткнуть, и покраснеет, когда время выйдет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一只小生物住在你的相机开孔里。开始计时后，它会替你盯着，被戳时会眨眼，时间一到就变红。"
          }
        }
      }
    },
