    "Long-press the island to open the big eyes." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولًا على الجزيرة لفتح العينين الكبيرتين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Insel gedrückt, um die großen Augen zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long-press the island to open the big eyes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada la isla para abrir los ojos grandes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez longuement sur l'îlot pour ouvrir les grands yeux."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बड़ी आँखें खोलने के लिए आइलैंड को देर तक दबाएँ।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイランドを長押しすると大きな目が開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아일랜드를 길게 누르면 큰 눈이 열려요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите и удерживайте остров, чтобы открыть большие глаза."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按灵动岛可展开大眼睛。"
          }
        }
      }
    },
    "Long-press the island to open the big eyes. Tap an eye and it blinks back at you." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولًا على الجزيرة لفتح العينين الكبيرتين. المس عينًا لترمش لك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Insel gedrückt, um die großen Augen zu öffnen. Tippe ein Auge an, und es blinzelt zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long-press the island to open the big eyes. Tap an eye and it blinks back at you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada la isla para abrir los ojos grandes. Toca un ojo y te guiñará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez longuement sur l'îlot pour ouvrir les grands yeux. Touchez un œil et il vous répond d'un clignement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बड़ी आँखें खोलने के लिए आइलैंड को देर तक दबाएँ। आँख पर टैप करें, वह पलक झपकाकर जवाब देगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイランドを長押しすると大きな目が開きます。目をタップするとまばたき返します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아일랜드를 길게 누르면 큰 눈이 열려요. 눈을 탭하면 깜빡여 줘요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите и удерживайте остров, чтобы открыть большие глаза. Коснитесь глаза — он моргнёт в ответ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按灵动岛展开大眼睛，点按眼睛，它会向你眨眼。"
          }
        }
      }
    },
